              "id": "bottom-row",
              "columns": [
                [
                  "copyright"
                ]
              ]
            }
          ],
          "items": [
            {
              "id": "copyright",
              "values": {
                "copyright_text": "© {current_year} {site_title}"
              }
            }
          ],
          "settings": {
            "footer_container_structure": "fixed"
          }
        }
