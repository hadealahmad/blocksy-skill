    {
      "name": "Example Main Menu",
      "location": "menu_1",
      "replace": true,
      "items": [
        {
          "key": "home",
          "title": "Home",
          "type": "custom",
          "url": "/"
        },
        {
          "key": "blog",
          "title": "Blog",
          "type": "custom",
          "url": "/blog/"
        },
