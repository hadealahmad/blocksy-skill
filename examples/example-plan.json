  "content_blocks": [
    {
      "key": "example-single-notice",
      "title": "Example Single Notice",
      "template_type": "hook",
      "status": "publish",
      "content": "<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"16px\",\"bottom\":\"16px\",\"left\":\"20px\",\"right\":\"20px\"}},\"border\":{\"radius\":\"8px\"}},\"backgroundColor\":\"palette-color-6\"} -->\n<div class=\"wp-block-group has-background\" style=\"border-radius:8px;background-color:var(--wp--preset--color--palette-color-6);padding-top:16px;padding-right:20px;padding-bottom:16px;padding-left:20px\"><!-- wp:paragraph -->\n<p>This is an example notice rendered by a Blocksy Content Block on single posts.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->",
      "meta": {
        "conditions": [
          {
            "type": "include",
            "rule": "single_post",
            "payload": []
          }
        ],
        "location": "blocksy:content:top",
        "priority": 10
      }
    }
  ],
  "post_meta": {
    "sample-page": {
      "page_structure_type": "type-2"
    }
  },
  "cache": true
